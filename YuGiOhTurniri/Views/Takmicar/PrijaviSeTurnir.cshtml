@model YuGiOhTurniri.Models.OdaberiSpilZaTurnirVM

@{
    ViewBag.Title = "Odaberi Spil za Turnir";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    console.log('[TURNIR PRIJAVA] Stranica u?itana');

    function submitPrijaviForm(forma) {
        console.log('[TURNIR PRIJAVA] submitPrijaviForm pozvana');
        console.log('[TURNIR PRIJAVA] Forma action:', forma.action);
        console.log('[TURNIR PRIJAVA] Forma method:', forma.method);

        // Prika?i indikator da se forma ?alje
        alert('Slanje zahtjeva na server... Trebalo bi da budete preusmjereni.');

        forma.submit();
    }

    // Osiguraj da se validacija JS inicijalizuje nakon ?to se DOM u?ita
    document.addEventListener('DOMContentLoaded', function() {
        console.log('[TURNIR PRIJAVA] DOMContentLoaded Event - validacija.js bi trebala biti inicijalizovana');

        // Provjeri da li je initializeFormValidation dostupna
        if (typeof initializeFormValidation !== 'undefined') {
            console.log('[TURNIR PRIJAVA] validacija.js je u?itana - initializeFormValidation je dostupna');
        } else {
            console.warn('[TURNIR PRIJAVA] UPOZORENJE: validacija.js nije u?itana!');
        }
    });
</script>

<div class="page-header">
    <h1 class="page-title">Odaberi Spil za Turnir</h1>
    <p class="page-subtitle">@Model.TurnirNaziv - Format: @Model.TurnirFormat</p>
</div>

@if (TempData["Greska"] != null)
{
    <div class="alert alert-danger">
        @TempData["Greska"]
    </div>
}

@if (Model.Spilovi == null || Model.Spilovi.Count == 0)
{
    <div class="alert alert-info">
        <strong>Nema dostupnih spilova!</strong>
        <p>Nemate kreirane spilove u formatu '@Model.TurnirFormat' ili su svi vasi spilovi vec u procesu revizije.</p>
        <a href="@Url.Action("OtvoreniTurniri", "Takmicar")" class="btn btn-secondary" style="margin-top: 1rem;">
            Nazad na turnire
        </a>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        @foreach (var spil in Model.Spilovi)
        {
            <div class="card">
                <div class="card-header">
                    <h3 style="margin: 0;">@spil.Naziv</h3>
                </div>
                <div class="card-body">
                    <p><strong>Format:</strong> @spil.Format</p>
                    <p><strong>Arhetip:</strong> @spil.Arhetip</p>
                    <p><strong>Status:</strong> @spil.Status</p>
                </div>
                <div style="padding: 1rem;">
                    @if (spil.Status == "Odobren")
                    {
                        <form method="post" action="@Url.Action("PotvrdiPrijavuNaTurnir", "Takmicar")" style="display: inline-block; width: 100%;" onsubmit="console.log('[TURNIR PRIJAVA] Form submit event - TurnirID=' + this.querySelector('[name=turnirID]').value + ', SpilID=' + this.querySelector('[name=spilID]').value); return true;">
                            <input type="hidden" name="turnirID" value="@Model.TurnirID" />
                            <input type="hidden" name="spilID" value="@spil.SpilID" />
                            <button type="submit" class="btn btn-success btn-block" style="width: 100%;" onclick="console.log('[TURNIR PRIJAVA] Dugme klikuto! TurnirID=@Model.TurnirID, SpilID=@spil.SpilID');">
                                Prijavi sa ovim spilom
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-block" disabled>
                            Status: @spil.Status
                        </button>
                        <p style="color: #d32f2f; margin-top: 0.5rem; font-size: 0.9rem;">
                            Spil mora biti odobren od strane sudije prije nego ?to se mo?ete prijaviti.
                        </p>
                    }
                </div>
            </div>
        }
    </div>

    <div style="margin-top: 2rem;">
        <a href="@Url.Action("OtvoreniTurniri", "Takmicar")" class="btn btn-secondary">
            Nazad na turnire
        </a>
    </div>
}
