@model List<YuGiOhTurniri.Models.BanListaPrikazVM>

@{
    ViewBag.Title = "Ban Lista";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Ban Lista</h1>
    <p class="page-subtitle">Zabranjene karte - Ne smijete koristiti u vasim spilovima</p>
</div>

@if (TempData["Poruka"] != null)
{
    <div class="alert alert-success">
        @TempData["Poruka"]
    </div>
}

@if (TempData["Greska"] != null)
{
    <div class="alert alert-danger">
        @TempData["Greska"]
    </div>
}

@if (ViewBag.Greska != null)
{
    <div class="alert alert-danger">
        @ViewBag.Greska
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        Nema zabanjenih karata. Sve karte su dozvoljene!
    </div>
}
else
{
    <div style="overflow-x: auto; margin-top: 1.5rem;">
        <table class="table table-striped table-bordered">
            <thead style="background-color: #f8f9fa;">
                <tr>
                    <th style="text-align: left; padding: 0.75rem;">Red. Broj</th>
                    <th style="text-align: left; padding: 0.75rem;">Naziv Karte</th>
                    <th style="text-align: left; padding: 0.75rem;">Datum Dodavanja</th>
                </tr>
            </thead>
            <tbody>
                @{int redBroj = 1;}
                @foreach (var stavka in Model)
                {
                    <tr>
                        <td style="padding: 0.75rem;">@redBroj</td>
                        <td style="padding: 0.75rem;">@stavka.NazivKarte</td>
                        <td style="padding: 0.75rem;">@stavka.DatumDodavanja.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                    redBroj++;
                }
            </tbody>
        </table>
    </div>
}
