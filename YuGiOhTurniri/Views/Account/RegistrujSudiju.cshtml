    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .text-danger {
        color: #721c24;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .auth-link {
        text-align: center;
        margin-top: 1.5rem;
        color: #666;
    }

