@model YuGiOhTurniri.Models.ProclasiPobjednikeVM

@{
    ViewBag.Title = "Proglasi Pobednike";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int takmicariCount = Model.Takmicari != null ? Model.Takmicari.Count : 0;
}

<div class="page-header">
    <h1 class="page-title">Proglasi Pobednike</h1>
    <p class="page-subtitle">Odaberite do tri najbolja takmicara</p>
</div>

<div class="card" style="max-width: 600px; margin: 2rem auto;">
    <div class="card-body">
        @using (Html.BeginForm("ProglasiPobednike", "Organizator", new { id = Model.TurnirID }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label for="PrvoMestoID" class="form-label">
                    <strong style="color: gold;">1. MESTO (Zlato) *</strong>
                </label>
                @Html.DropDownListFor(m => m.PrvoMestoID, Model.Takmicari, "-- Odaberite takmičara --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PrvoMestoID, "", new { @class = "text-danger" })
            </div>

            if (takmicariCount >= 2)
            {
                <div class="form-group mb-3">
                    <label for="DrugoMestoID" class="form-label">
                        <strong style="color: silver;">2. MESTO (Srebro)</strong>
                    </label>
                    @Html.DropDownListFor(m => m.DrugoMestoID, Model.Takmicari, "-- Odaberite takmičara --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DrugoMestoID, "", new { @class = "text-danger" })
                </div>
            }

            if (takmicariCount >= 3)
            {
                <div class="form-group mb-3">
                    <label for="TreceMestoID" class="form-label">
                        <strong style="color: #cd7f32;">3. MESTO (Bronza)</strong>
                    </label>
                    @Html.DropDownListFor(m => m.TreceMestoID, Model.Takmicari, "-- Odaberite takmičara --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.TreceMestoID, "", new { @class = "text-danger" })
                </div>
            }

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">Proglasi Pobednike</button>
                <a href="@Url.Action("DetaljiTurnira", "Organizator", new { id = Model.TurnirID })" class="btn btn-secondary">Otkaži</a>
            </div>
        }
    </div>
</div>

