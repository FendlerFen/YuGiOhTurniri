@model YuGiOhTurniri.Models.KreirajTurnirVM

@{
    ViewBag.Title = "Kreiraj Turnir";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Kreiraj Novi Turnir</h1>
    <p class="page-subtitle">Postavite parametre za vas turnir</p>
</div>

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body">
        @using (Html.BeginForm("KreirajTurnir", "Organizator", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "form-error" })

            <div class="form-group">
                <label>Naziv Turnira</label>
                @Html.TextBoxFor(x => x.Naziv, new { @class = "form-control", placeholder = "npr: YuGiOh Svetski Kup" })
                @Html.ValidationMessageFor(x => x.Naziv, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Lokacija</label>
                @Html.TextBoxFor(x => x.Lokacija, new { @class = "form-control", placeholder = "npr: Beograd, Stadion Partizana" })
                @Html.ValidationMessageFor(x => x.Lokacija, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Format</label>
                @if (Model?.Formati != null && Model.Formati.Count > 0)
                {
                    @Html.DropDownListFor(x => x.Format, Model.Formati, "-- Odaberite format --", new { @class = "form-control" })
                }
                else
                {
                    <select name="Format" class="form-control">
                        <option value="">-- Odaberite format --</option>
                        <option value="TCG">TCG</option>
                        <option value="OCG">OCG</option>
                        <option value="Speed Duel">Speed Duel</option>
                    </select>
                }
                @Html.ValidationMessageFor(x => x.Format, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Datum Odrzavanja</label>
                <input type="date" name="DatumOdrzavanja" id="DatumOdrzavanja" class="form-control" value="@Model.DatumOdrzavanja.ToString("yyyy-MM-dd")" />
                @Html.ValidationMessageFor(x => x.DatumOdrzavanja, "", new { @class = "form-error" })
            </div>

            <button type="submit" class="btn btn-success btn-block">Kreiraj Turnir</button>
            <a href="@Url.Action("MojiTurniri", "Organizator")" class="btn btn-secondary btn-block" style="margin-top: 0.5rem;">Nazad</a>
        }
    </div>
</div>

<style>
    input[type="date"] {
        padding: 0.375rem 0.75rem;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }
    input[type="date"]:focus {
        border-color: #80bdff;
        outline: 0;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }
</style>

