@model YuGiOhTurniri.Models.RegistacijaOrganizatoraVM

@{
    ViewBag.Title = "Registracija Organizatora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">Registracija Organizatora</h1>

        @using (Html.BeginForm("RegistrujOrganizatora", "Organizator", FormMethod.Post, new { @class = "form-validation" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "form-error" })

            <div class="form-group">
                <label>Naziv organizacije</label>
                @Html.TextBoxFor(x => x.NazivOrganizacije, new { @class = "form-control", placeholder = "Naziv organizacije" })
                @Html.ValidationMessageFor(x => x.NazivOrganizacije, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Ime osobe odgovorne</label>
                @Html.TextBoxFor(x => x.Ime, new { @class = "form-control", placeholder = "Unesite ime" })
                @Html.ValidationMessageFor(x => x.Ime, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Prezime</label>
                @Html.TextBoxFor(x => x.Prezime, new { @class = "form-control", placeholder = "Unesite prezime" })
                @Html.ValidationMessageFor(x => x.Prezime, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Elektronska adresa</label>
                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "Unesite email", type = "email" })
                @Html.ValidationMessageFor(x => x.Email, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Telefonski broj</label>
                @Html.TextBoxFor(x => x.TelefonBroj, new { @class = "form-control", placeholder = "Unesite telefonski broj" })
                @Html.ValidationMessageFor(x => x.TelefonBroj, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Drzava</label>
                @Html.TextBoxFor(x => x.Drzava, new { @class = "form-control", placeholder = "Unesite drzavu" })
                @Html.ValidationMessageFor(x => x.Drzava, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Lozinka</label>
                @Html.PasswordFor(x => x.Lozinka, new { @class = "form-control", placeholder = "Unesite lozinku" })
                @Html.ValidationMessageFor(x => x.Lozinka, "", new { @class = "form-error" })
            </div>

            <div class="form-group">
                <label>Potvrdi lozinku</label>
                @Html.PasswordFor(x => x.PotvrdiLozinku, new { @class = "form-control", placeholder = "Ponovite lozinku" })
                @Html.ValidationMessageFor(x => x.PotvrdiLozinku, "", new { @class = "form-error" })
            </div>

            <button type="submit" class="btn btn-success btn-block">Registruj se</button>
        }

        <div class="auth-link">
            Vec imate nalog? <a href="@Url.Action("PrijaviOrganizatora", "Organizator")">Prijavite se</a>
        </div>
    </div>
</div>

